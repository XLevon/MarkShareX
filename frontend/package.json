{
  "name": "marksharex-frontend",
  "version": "0.4.2",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-lan": "vite --host 0.0.0.0",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --experimental-strip-types --test tests/*.test.ts",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --max-warnings=0"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.12.0",
    "axios": "^1.18.0",
    "dayjs": "^1.11.0",
    "dompurify": "^3.4.12",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "marked": "^15.0.0",
    "naive-ui": "^2.40.0",
    "pinia": "^3.0.0",
    "qrcode": "^1.5.4",
    "vditor": "^3.10.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
