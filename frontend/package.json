{
  "name": "marksharex-frontend",
  "version": "0.4.2",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-lan": "vite --host 0.0.0.0",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --experimental-strip-types --test tests/*.test.ts",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --max-warnings=0"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "marked": "^15.0.0",
    "naive-ui": "^2.45.3",
    "pinia": "^3.0.0",
    "qrcode": "^1.5.4",
    "vditor": "^3.11.3",
    "vue": "^3.5.43",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  }
}
