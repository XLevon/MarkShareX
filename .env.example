# ==============================================================================
# MarkShareX 环境变量配置
# 使用方式: 复制此文件为 .env，然后根据需要修改
# ==============================================================================

# ------------------------------ 安全配置 ------------------------------
# JWT 密钥（必须修改！用于加密用户 Token）
# 建议使用至少 32 位的随机字符串
# 示例: marksharex-dev-secret-key-2026
MARKSHAREX_AUTH_JWT_SECRET=change-me-to-a-random-32-char-secret

# JWT 过期时间（秒），默认 1 小时
# 示例: 3600
MARKSHAREX_AUTH_JWT_EXPIRE_SECONDS=3600

# Refresh Token 过期时间（秒），默认 7 天
# 示例: 604800
MARKSHAREX_AUTH_REFRESH_EXPIRE_SECONDS=604800

# ------------------------------ 数据库配置 ------------------------------
# 数据库连接 URL
# SQLite（默认）:
# macOS示例: sqlite:///Users/user/.marksharex/data/marksharex.db?mode=rwc
# Linux示例: sqlite:///root/user/.marksharex/data/marksharex.db?mode=rwc
MARKSHAREX_DATABASE_URL=sqlite://./data/marksharex.db?mode=rwc
# PostgreSQL（需要修改 Cargo.toml 启用 postgres 特性）:
# MARKSHAREX_DATABASE_URL=postgres://username:password@localhost:5432/marksharex

# 数据库最大连接数
# 示例: 10
MARKSHAREX_DATABASE_MAX_CONNECTIONS=10

# 数据库最小连接数
# 示例: 1
MARKSHAREX_DATABASE_MIN_CONNECTIONS=1

# ------------------------------ 服务器配置 ------------------------------
# 服务器监听地址
# 示例: 0.0.0.0
MARKSHAREX_SERVER_HOST=0.0.0.0

# 服务器监听端口
# 示例: 5023
MARKSHAREX_SERVER_PORT=5023

# 服务器基础 URL（用于生成绝对路径 URL，如文件下载链接）
# 开发环境:
# 示例: http://0.0.0.0:5023
MARKSHAREX_SERVER_BASE_URL=http://localhost:5023
# 生产环境示例:
# MARKSHAREX_SERVER_BASE_URL=https://blog.your-domain.com

# ------------------------------ 数据存储配置 ------------------------------
# 数据目录（存放数据库、上传文件、主题等）
# 示例: ./data
MARKSHAREX_DATA_DIR=./data

# 上传文件存储目录
# 示例: ./data/uploads
MARKSHAREX_STORAGE_UPLOAD_DIR=./data/uploads

# 最大文件大小（字节），默认 10MB
# 示例: 10485760
MARKSHAREX_STORAGE_MAX_FILE_SIZE=10485760

# ------------------------------ 主题配置 ------------------------------
# 默认主题名称
# 示例: default
MARKSHAREX_THEME=default