# ==============================================================================
# MarkShareX 环境变量模板
# ==============================================================================
# 
# 配置模板，复制后必须生成并填写两个认证密钥：
#   cp .env.example .env
#
# 环境变量格式: MARKSHAREX_<SECTION>_<KEY>
# 例如: MARKSHAREX_SERVER_PORT=8080 覆盖 [server] port
# ==============================================================================

# ------------------------------ 全局 ------------------------------
# 数据目录（SQLite 数据库、上传文件、搜索索引）
MARKSHAREX_DATA_DIR=./data

# ------------------------------ 服务器 ------------------------------
MARKSHAREX_SERVER_HOST=0.0.0.0
MARKSHAREX_SERVER_PORT=5023
# 逗号分隔的精确可信代理 IP；不支持 CIDR。直连部署留空。
MARKSHAREX_SERVER_TRUSTED_PROXIES=
# 逗号分隔的精确跨域 origin；留空表示禁止跨域。不要使用 `*` 或带路径的 URL。
MARKSHAREX_SERVER_CORS_ALLOWED_ORIGINS=

# ------------------------------ 数据库 ------------------------------
MARKSHAREX_DATABASE_URL=sqlite://./data/marksharex.db?mode=rwc
MARKSHAREX_DATABASE_MAX_CONNECTIONS=10
MARKSHAREX_DATABASE_MIN_CONNECTIONS=1

# ------------------------------ 认证 ------------------------------
# JWT 签名密钥；必须生成独立随机值：openssl rand -base64 64
MARKSHAREX_AUTH_JWT_SECRET=
MARKSHAREX_AUTH_JWT_EXPIRE_SECONDS=3600
MARKSHAREX_AUTH_REFRESH_EXPIRE_SECONDS=604800

# AES-256-GCM 加密密钥 — 用于加密 AI API Key 等敏感数据
# 格式: 任意字符串，取前 32 字节作为密钥（不足补零，超出截断）
# ⚠️ 部署时务必生成并固定，切勿修改！修改后已加密的 API Key 将无法解密，需重新输入
# 必须生成并固定：openssl rand -base64 32
MARKSHAREX_AUTH_ENCRYPT_KEY=

# ------------------------------ 存储 ------------------------------
# 上传文件目录
MARKSHAREX_STORAGE_UPLOAD_DIR=./data/uploads
# 最大文件大小（字节）
MARKSHAREX_STORAGE_MAX_FILE_SIZE=20971520
# 逗号分隔的 MIME 类型
MARKSHAREX_STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/markdown,text/plain,application/zip

# ------------------------------ AI ------------------------------
# 工具调用最大轮次（资讯采集等复杂任务建议 12-15）
MARKSHAREX_AI_MAX_TOOL_ROUNDS=8
# 逗号分隔的 provider 私网 IP/CIDR allowlist
MARKSHAREX_AI_ALLOWED_PROVIDER_NETWORKS=

# AI 搜索及降级链；Provider: tavily | firecrawl | searxng | duckduckgo
MARKSHAREX_AI_SEARCH_PROVIDER=tavily
MARKSHAREX_AI_SEARCH_API_KEY=
MARKSHAREX_AI_SEARCH_FALLBACK_PROVIDER=firecrawl
MARKSHAREX_AI_SEARCH_FALLBACK_API_KEY=
MARKSHAREX_AI_SEARCH_SEARXNG_URL=
MARKSHAREX_AI_SEARCH_DUCKDUCKGO_URL=https://lite.duckduckgo.com/lite/
# 逗号分隔，仅适用于配置型 SearXNG/DDG 服务
MARKSHAREX_AI_SEARCH_ALLOWED_SEARCH_NETWORKS=
