# ==============================================================================
# MarkShareX 环境变量模板
# ==============================================================================
# 
# 正常情况下所有配置在 config.toml 中管理，不需要 .env 文件。
# 此文件仅在需要临时覆盖 config.toml 中的某个值，或 Docker 部署时使用。
#
# 将本文件复制为 .env 后修改：
#   cp .env.example .env
#
# 环境变量格式: MARKSHAREX_<SECTION>_<KEY>
# 例如: MARKSHAREX_SERVER_PORT=8080 覆盖 [server] port
# ==============================================================================

# ------------------------------ 全局 ------------------------------
# 数据目录（SQLite 数据库、上传文件、搜索索引）
# MARKSHAREX_DATA_DIR=./data

# ------------------------------ 服务器 ------------------------------
# MARKSHAREX_SERVER_HOST=0.0.0.0
# MARKSHAREX_SERVER_PORT=5023

# ------------------------------ 数据库 ------------------------------
# MARKSHAREX_DATABASE_URL=sqlite://./data/marksharex.db?mode=rwc
# MARKSHAREX_DATABASE_MAX_CONNECTIONS=10
# MARKSHAREX_DATABASE_MIN_CONNECTIONS=1

# ------------------------------ 认证 ------------------------------
# AES-256-GCM 加密密钥 — 用于加密 AI API Key 等敏感数据
# 格式: 任意字符串，取前 32 字节作为密钥（不足补零，超出截断）
# 生成: openssl rand -base64 32
# ⚠️ 部署时务必生成并固定，切勿修改！修改后已加密的 API Key 将无法解密，需重新输入
# ⚠️ 多环境必须一致，否则加密数据不互通
# MARKSHAREX_ENCRYPT_KEY=***

# ------------------------------ 存储 ------------------------------
# 上传文件目录
# MARKSHAREX_STORAGE_UPLOAD_DIR=./data/uploads

# ------------------------------ AI ------------------------------
# 工具调用最大轮次（资讯采集等复杂任务建议 12-15）
# MARKSHAREX_AI_MAX_TOOL_ROUNDS=8
